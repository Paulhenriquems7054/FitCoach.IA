{
  "name": "fitcoach-ia-agente-treinamento-inteligente",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./start-dev-safe.ps1",
    "dev:start": "vite --host 0.0.0.0 --port 3000",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "dev:force": "powershell -ExecutionPolicy Bypass -Command \"& { .\\kill-port-3000.ps1; vite --force --host 0.0.0.0 --port 3000 }\"",
    "kill:ports": "powershell -ExecutionPolicy Bypass -File ./kill-port-3000.ps1",
    "kill:port3000": "powershell -ExecutionPolicy Bypass -File ./kill-port-3000.ps1",
    "clean:cache": "powershell -ExecutionPolicy Bypass -Command \"if (Test-Path 'node_modules/.vite') { Remove-Item -Path 'node_modules/.vite' -Recurse -Force }; if (Test-Path 'dist') { Remove-Item -Path 'dist' -Recurse -Force }; Get-ChildItem -Path '.' -Filter 'vite.config.ts.timestamp-*' | Remove-Item -Force\"",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-favicon": "node scripts/generate-favicon.js",
    "generate-app-icons": "node scripts/generate-app-icons.js",
    "check-config": "node scripts/check-config.js",
    "server": "node server/gym-server.js",
    "normalize:gifs": "node scripts/normalize-gifs.js",
    "normalize:gifs:dry": "node scripts/normalize-gifs.js --dry-run"
  },
  "dependencies": {
    "@google/genai": "^1.28.0",
    "@heroicons/react": "^2.2.0",
    "@jest/globals": "^30.2.0",
    "@supabase/supabase-js": "^2.84.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.12.1",
    "jspdf": "^2.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "recharts": "^3.3.0",
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "10.4.22",
    "esbuild": "^0.27.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "postcss": "8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.18",
    "ts-jest": "^29.4.5",
    "typescript": "~5.8.2",
    "vite": "5.4.21",
    "vite-plugin-remove-console": "2.2.0"
  }
}
